[Unit]
Description=Pi Companion button voice terminal
After=network.target pi-companion-llm@%i.service
Requires=pi-companion-llm@%i.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/pi-companion
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/%i/pi-companion/.venv/bin/python /home/%i/pi-companion/companion.py --gpio
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
